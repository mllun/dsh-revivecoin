{
  "name": "@local/dsh-revivecoin",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Revival coins for DeepSeek Harness: package this instance of the assistant (sessions, persona, plugins, plugin data, config) into a restorable coin with daily refresh, diff and one-command restore.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "backup",
    "restore",
    "backup-restore",
    "agent-tools"
  ],
  "author": "mllun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mllun/dsh-revivecoin.git"
  },
  "homepage": "https://github.com/mllun/dsh-revivecoin",
  "bugs": {
    "url": "https://github.com/mllun/dsh-revivecoin/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "tsconfig.json",
    "tsconfig.client.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/smoke.mjs && node test/client-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^26.6.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
