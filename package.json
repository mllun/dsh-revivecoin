{
  "name": "@local/dsh-revivecoin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Revival coins for DeepSeek Harness: package this instance of the assistant (sessions, persona, plugins, plugin data, config) into a restorable coin with daily refresh, diff and one-command restore.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "backup",
    "restore",
    "backup-restore",
    "agent-tools"
  ],
  "author": "mllun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mllun/dsh-revivecoin.git"
  },
  "homepage": "https://github.com/mllun/dsh-revivecoin",
  "bugs": {
    "url": "https://github.com/mllun/dsh-revivecoin/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
